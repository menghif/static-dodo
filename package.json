{
  "name": "static-dodo",
  "version": "1.1.0",
  "description": "A simple Static Site Generator CLI",
  "main": "static-dodo.js",
  "type": "module",
  "bin": {
    "static-dodo": "static-dodo.js"
  },
  "keywords": [
    "cli"
  ],
  "preferGlobal": true,
  "author": "Francesco Menghi",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prettier": "pnpx prettier --write .",
    "prettier-check": "pnpx prettier --check .",
    "eslint": "pnpx eslint --config eslint.config.js",
    "eslint-fix": "pnpx eslint --config eslint.config.js --fix",
    "prepare": "husky",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  }
}
